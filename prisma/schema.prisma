generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MODELS ──────────────────────────────────────────────

model College {
  id        String   @id @default(uuid())
  name      String   @unique
  shortName String?
  city      String?
  state     String?
  logoUrl   String?
  createdAt DateTime @default(now()) @map("created_at")

  users User[]
  moderators User[] @relation("CollegeModerators")
  moderationLogs ModerationLog[]

  @@map("colleges")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  googleId      String?  @unique @map("google_id") // set when the account was created via — or linked to — Google Sign-In
  username      String   @unique
  displayName   String   @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  collegeId     String?  @map("college_id")
  course        String?
  year          Int?
  gender        String?  @default("UNKNOWN")
  dateOfBirth   DateTime? @map("date_of_birth")
  avatarColor   String?  @map("avatar_color")
  avatarPhotoId String?  @unique @map("avatar_photo_id")
  isVerified    Boolean  @default(false) @map("is_verified")
  // What this person is on the app for — shown on cards/profiles, and the
  // basis of intent matching. MULTI-SELECT of DATING | RELATIONSHIP | HOOKUP |
  // CASUAL | NOT_SURE. Empty list = "rather not say" (never filters anyone out).
  relationshipGoals String[] @default([]) @map("relationship_goals")
  verificationStatus String @default("UNVERIFIED") @map("verification_status") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  isActive      Boolean  @default(true) @map("is_active")
  role          String   @default("user")
  // SUPREME HIERARCHY:
  // - isFounder: the creator. Immutable, untouchable — no endpoint can demote,
  //   ban, or delete the founder, and no endpoint can create another founder.
  // - moderatedCollegeId: the campus this moderator is ASSIGNED to. A college
  //   admin's entire moderation scope is this college if set, else the college
  //   they study in. Set only by the founder/super-admin from the console.
  isFounder     Boolean  @default(false) @map("is_founder")
  moderatedCollegeId String? @map("moderated_college_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  college          College?           @relation(fields: [collegeId], references: [id])
  moderatedCollege College?           @relation("CollegeModerators", fields: [moderatedCollegeId], references: [id])
  interests        UserInterest[]
  posts            Post[]
  comments         Comment[]
  postLikes        PostLike[]
  savedPosts       SavedPost[]
  sentLikes        MatchLike[]        @relation("SentLikes")
  receivedLikes    MatchLike[]        @relation("ReceivedLikes")
  matchesA         Match[]            @relation("MatchUserA")
  matchesB         Match[]            @relation("MatchUserB")
  matchPreference  MatchPreference?
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationActor")
  sentMessages     Message[]
  conversations    ConversationMember[]
  reports          Report[]           @relation("ReportReporter")
  bannedReports    Report[]           @relation("ReportResolver")
  blockedUsers     Block[]            @relation("BlockBlocker")
  blockedBy        Block[]            @relation("BlockBlocked")
  moderationActions ModerationLog[]   @relation("ModerationActor")
  refreshTokens    RefreshToken[]
  photos           UserPhoto[]
  avatarPhoto      UserPhoto?         @relation("UserAvatarPhoto", fields: [avatarPhotoId], references: [id])
  idVerifications  IdVerification[]

  @@map("users")
}

// ─── PHOTOS ──────────────────────────────────────────────
// Gallery photos: new uploads go to Supabase Storage (private bucket,
// served via short-lived signed URLs after the same-college check).
// `data` is the legacy Postgres-bytes column — kept nullable so the
// one-time migration can run without downtime; rows with a `storagePath`
// are served from Storage, rows without fall back to `data`.
// slot 0 = profile picture · slots 1-3 = extra gallery photos for matching.
model UserPhoto {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  data        Bytes?   // legacy Postgres bytes; null for Storage-backed photos
  storagePath String?  @map("storage_path") // e.g. "<userId>/<photoId>"
  mimeType    String   @map("mime_type")
  slot        Int      @default(0) // 0 = profile pic, 1-3 = gallery
  createdAt   DateTime @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarOfUser  User?     @relation("UserAvatarPhoto")

  @@index([userId, slot])
  @@map("user_photos")
}

// ─── STUDENT ID VERIFICATION ─────────────────────────────
// Privacy: the ID photo is kept ONLY while a decision is pending; it is
// deleted the moment the verification resolves (auto or human review).
model IdVerification {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  imageData      Bytes?    @map("image_data") // nulled after decision — never retained
  mimeType       String    @map("mime_type")
  status         String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  autoDecision   String?   @map("auto_decision") // APPROVED | REJECTED | REVIEW | SKIPPED
  autoConfidence Float?    @map("auto_confidence")
  autoReason     String?   @map("auto_reason")
  decidedBy      String?   @map("decided_by") // null = automatic
  createdAt      DateTime  @default(now()) @map("created_at")
  decidedAt      DateTime? @map("decided_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@map("id_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Interest {
  id       String @id @default(uuid())
  name     String @unique
  category String?

  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String @map("user_id")
  interestId String @map("interest_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}

model Post {
  id          String   @id @default(uuid())
  authorId    String   @map("author_id")
  content     String
  mediaUrl    String?  @map("media_url")
  mediaType   String   @default("NONE") @map("media_type")
  type        String   @default("NORMAL")
  visibility  String   @default("PUBLIC")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  author   User          @relation(fields: [authorId], references: [id])
  comments Comment[]
  likes    PostLike[]
  saves    SavedPost[]

  @@index([authorId])
  @@index([createdAt])
  @@index([type])
  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid())
  postId          String    @map("post_id")
  authorId        String    @map("author_id")
  parentCommentId String?   @map("parent_comment_id")
  content         String
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  createdAt       DateTime  @default(now()) @map("created_at")
  editedAt        DateTime? @map("edited_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentReplies")

  @@index([postId])
  @@map("comments")
}

model PostLike {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_likes")
}

/// Bookmarked posts (Reddit/Instagram "Save"). One row per user+post.
model SavedPost {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

// ─── MATCHING ────────────────────────────────────────────

model MatchPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  lookingFor         String   @default("DATING") @map("looking_for")
  ageRangeMin        Int?     @map("age_range_min")
  ageRangeMax        Int?     @map("age_range_max")
  genderPreference   String   @default("EVERYONE") @map("gender_preference")
  // INTENT MATCHING: which relationship goals may enter the deck (multi).
  // Empty list = open to every goal. Goals never silently exclude anyone
  // unless the viewer opts in — intent is a preference, not a wall.
  openToGoals        String[] @default([]) @map("open_to_goals")
  // DEALBREAKERS — hard filters the viewer opts into:
  minYear            Int?     @map("min_year") // null = any year
  sharedInterestMin  Int      @default(0) @map("shared_interest_min") // 0 = off, 1+ = require N common interests
  locationPreference String?  @map("location_preference")
  collegePreference  String?  @map("college_preference")
  visibility         Boolean  @default(true)
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("match_preferences")
}

model MatchLike {
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  action     String   @default("LIKE") // LIKE | PASS — passes resurface after PASS_RESURFACE_DAYS
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentLikes", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedLikes", fields: [receiverId], references: [id], onDelete: Cascade)

  @@id([senderId, receiverId])
  @@index([senderId, action, createdAt])
  @@map("match_likes")
}

model Match {
  id        String   @id @default(uuid())
  userA     String   @map("user_a")
  userB     String   @map("user_b")
  type      String
  // Snapshot of STRICTLY-common criteria at match time — shown in the MATCH
  // notification ("you both listed: Dating · 2 shared interests"). Only
  // intersections are stored; anything not shared by BOTH is omitted.
  // Shape: { goals: string[], interests: { id, name }[] }
  criteria  Json?    @map("criteria")
  status    String   @default("ACTIVE") // ACTIVE | ENDED (unmatched)
  createdAt DateTime @default(now()) @map("created_at")
  endedAt   DateTime? @map("ended_at")
  endedBy   String?  @map("ended_by")

  userAObj User @relation("MatchUserA", fields: [userA], references: [id])
  userBObj User @relation("MatchUserB", fields: [userB], references: [id])

  @@unique([userA, userB])
  @@index([userA, status])
  @@index([userB, status])
  @@map("matches")
}

// ─── MESSAGING ───────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  mediaUrl       String?   @map("media_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  recipientId String    @map("recipient_id")
  actorId     String?   @map("actor_id")
  type        String
  // Type-specific payload (MATCH notifications carry the common-criteria snapshot:
  // { goals: string[], interests: { id, name }[] }) — rendered as chips in the UI.
  metadata    Json?     @map("metadata")
  postId      String?   @map("post_id")
  commentId   String?   @map("comment_id")
  matchId     String?   @map("match_id")
  isRead      Boolean   @default(false) @map("is_read")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@map("notifications")
}

// ─── REPORTS & BLOCKS ────────────────────────────────────

model Report {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  reason      String
  description String?
  status      String    @default("PENDING")
  resolverId  String?   @map("resolver_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolverId], references: [id])

  @@index([status])
  @@map("reports")
}model Block {
  blockerId  String   @map("blocker_id")
  blockedId  String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  // PERF: the feed loads BOTH directions of the block list on EVERY request
  // ("who did I block + who blocked me"); without these it is a table scan.
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

// ─── MODERATION AUDIT LOG ────────────────────────────────────
// Append-only record of staff actions: bans, unbans, role changes, ID
// decisions, content takedowns, report resolutions, announcements.
// collegeId = the moderated scope (target's college) so college admins see
// only their own campus in the Activity tab; super-admins see everything.
model ModerationLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  collegeId  String?  @map("college_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor   User     @relation("ModerationActor", fields: [actorId], references: [id])
  college College? @relation(fields: [collegeId], references: [id])

  @@index([collegeId, createdAt])
  @@index([actorId, createdAt])
  @@map("moderation_logs")
}
