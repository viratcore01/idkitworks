{
  "name": "skola-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node -e \"try{require('fs').rmSync('node_modules/.prisma',{recursive:true,force:true})}catch{}\" && prisma generate --schema=../prisma/schema.prisma && tsc",
    "start": "export DIRECT_URL=${DIRECT_URL:-$DATABASE_URL}; prisma migrate deploy --schema=../prisma/schema.prisma && node dist/server.js",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "db:seed": "ts-node ../prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "ops:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "ops:smtp-check": "tsx scripts/smtp-check.ts",
    "photos:migrate": "tsx scripts/migrate-photos-to-storage.ts",
    "photos:migrate:dry": "tsx scripts/migrate-photos-to-storage.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
