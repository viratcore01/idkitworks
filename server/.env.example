# Zoclo API — environment template
# Copy to server/.env and fill in real values.

# ── Required ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/zoclo"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too-different-string"

# ── Auth ────────────────────────────────────────────────────
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Optional: enables Google Sign-In (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=""

# ── Outbound email (college-verification OTP codes) ──────────
# The sender is always the company Gmail account (GMAIL_USER).
#
# PRODUCTION: managed hosts block outbound SMTP ports (Render blocks 25,
# 465 and 587), so Gmail SMTP times out there. Use the Gmail API over HTTPS
# instead — set the three OAuth values below. Mint them with
# `npm run ops:gmail-auth` (walks through the Google Cloud console).
GMAIL_USER=""
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
#
# LOCAL ONLY: SMTP + app password. Needs a Gmail APP PASSWORD (not the login
# password): Google Account → Security → 2-Step Verification → App passwords
# → create one named "Zoclo API" → paste the 16-letter code. Used only when
# the OAuth trio above is unset.
GMAIL_APP_PASSWORD=""
#
# Verify either transport:  npm run ops:email-check -- --send

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ── Prisma pool tuning (optional, sane defaults built in) ──
DATABASE_CONNECTION_LIMIT=""
DATABASE_POOL_TIMEOUT=""

# ── Supabase Storage for photos (optional but recommended) ──
# Without these the API falls back to storing photo bytes in Postgres.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PHOTOS_BUCKET="user-photos"
PHOTO_URL_TTL_SEC="300"
