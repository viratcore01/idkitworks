# Zoclo API — environment template
# Copy to server/.env and fill in real values.

# ── Required ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/zoclo"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too-different-string"

# ── Auth ────────────────────────────────────────────────────
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Optional: enables Google Sign-In (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=""

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ── Prisma pool tuning (optional, sane defaults built in) ──
DATABASE_CONNECTION_LIMIT=""
DATABASE_POOL_TIMEOUT=""

# ── Supabase Storage for photos (optional but recommended) ──
# Without these the API falls back to storing photo bytes in Postgres.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PHOTOS_BUCKET="user-photos"
PHOTO_URL_TTL_SEC="300"
