[TEMPLATE]
# ── Zoclo env template ──────────────────────────────────────
# Server reads server/.env (dotenv, cwd=server). Client reads client/.env
# VITE_* at BUILD time (Vercel → project env vars, redeploy after changing).
# NEVER commit real secrets. See LAUNCH.md §2 for launch values.

# ── Database (Supabase postgres) ──
# Session pooler URL. Pool sizing is owned by env vars below (config/prisma.ts
# overwrites URL params at boot, so set these — not ?connection_limit=).
# POOL MATH (see SCALING.md pool note — free pooler = 15 sessions):
#   instances × DATABASE_CONNECTION_LIMIT + scripts/monitors < pool size.
#   Render API = 4, local scripts/suite = 2. Never run two servers + suite.
DATABASE_URL="postgresql://postgres:<password>@<ref>.pooler.supabase.com:5432/postgres?connect_timeout=15"
DATABASE_CONNECTION_LIMIT="4"
DATABASE_POOL_TIMEOUT="20"
# 1 = inject pgbouncer=true (REQUIRED on Supabase Supavisor pooler URLs).
# 0 = self-hosted Postgres (direct, no pooler) — keeps prepared-statement
# caching. Supabase deploys: leave unset. Self-hosted VM: set to "0".
# DATABASE_PGBOUNCER="0"
# Seconds between pool heartbeats that hold sessions (0 = off). The heartbeat
# defends the 15-session free pooler from idle reaping — dead weight against
# self-hosted Postgres (max_connections=200). Self-hosted VM: set "0".
# DATABASE_HEARTBEAT_SEC="0"
# Direct connection — used ONLY by `prisma migrate deploy`, never at runtime.
# (server start script defaults it to DATABASE_URL when unset.)
DIRECT_URL="postgresql://postgres:<password>@<ref>.pooler.supabase.com:5432/postgres?connect_timeout=15"

# ── Auth ──
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
# Access-token TTL. 60m default = 4x fewer refresh-rotation writes than 15m.
JWT_EXPIRES_IN="60m"
JWT_REFRESH_EXPIRES_IN="7d"
# Optional: enables the Google Sign-In button (client auto-detects via /health).
# GOOGLE_CLIENT_ID="650769239333-....apps.googleusercontent.com"

# ── Outbound email (server only — college-verification OTP codes) ──
# Company Gmail via SMTP. GMAIL_APP_PASSWORD is a 16-letter APP PASSWORD
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT the Gmail login password. Never commit it.
# GMAIL_USER="idkitworks01@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── Server ──
PORT=5000
NODE_ENV="development"
# Comma-separated browser origins (multi-origin aware in server.ts).
# Production: your real frontend origin(s), e.g.
# CLIENT_URL="https://app.zoclo.com,http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# ── Photo storage — driver-selectable (server only, never VITE_*) ──
# Two drivers, same keys, same signed-URL behavior (see config/storage.ts).
# Default driver = supabase (current deploy). Self-hosted VM = r2.
# STORAGE_DRIVER="r2"
#
# R2 (Cloudflare — S3 API, private bucket, signed URLs):
# R2_ACCOUNT_ID="<cloudflare account id — the <xxx> in <xxx>.r2.cloudflarestorage.com>"
# R2_ACCESS_KEY_ID="<R2 API token access key>"
# R2_SECRET_ACCESS_KEY="<R2 API token secret>"
# R2_BUCKET="user-photos"
#
# Supabase Storage (default — private bucket):
# SUPABASE_URL="https://<your-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service_role key — Supabase → Project Settings → API>"
# SUPABASE_PHOTOS_BUCKET="user-photos"
#
# Signed-URL TTL seconds. 3600 = browsers re-sign hourly, not every 4 min.
# PHOTO_URL_TTL_SEC="3600"

# ── R2 cost guard ($0 enforcement) ──
# The upload kill switch lives in the DB (app_settings.r2_cost_guard) and is
# driven by server/scripts/check-r2-usage.ts on a cron. Requires a SECOND
# Cloudflare token with ANALYTICS read scope — the bucket-scoped object token
# above cannot read usage analytics (verified live: "not authorized").
# CF_API_TOKEN_ANALYTICS="<read-all-resources token>"
# Cron (VM): */15 * * * * cd /srv/zoclo/server && npx tsx scripts/check-r2-usage.ts
# Optional Telegram alerts on pause (same bot as the uptime watchdog):
# TELEGRAM_BOT_TOKEN="<from @BotFather>"
# TELEGRAM_CHAT_ID="<your chat id>"
# Optional headroom tuning (fractions of the free cap):
# R2_USAGE_PAUSE_STORAGE=0.8   # pause new uploads at 80% of 10 GB
# R2_USAGE_PAUSE_CLASS_A=0.8   # …of 1M writes/month
# R2_USAGE_PAUSE_CLASS_B=0.8   # …of 10M reads/month

# ── Client (client/.env or Vercel env) ──
# VITE_API_URL="https://zoclo-api.onrender.com"   (bare host, no /api suffix)
